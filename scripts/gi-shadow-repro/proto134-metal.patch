+// PROTO(Thema 134): measurement-only switches for the GI shadow mask, read once.
+//   HE_GI_PROTO_SPP=N      rays per pixel (default 1)
+//   HE_GI_PROTO_STRAT=1    3x3-periodic R2 stratification of the cone samples
+//   HE_GI_PROTO_HIST=w     history weight (default 0.9)
+//   HE_GI_PROTO_ATROUS=K   K edge-aware a-trous iterations instead of the 3x3 box
+//                          (-1 = no spatial filter at all)
+//   HE_GI_PROTO_SIGL=s     a-trous value stop in Bernoulli sigmas (0 = off, default 0)
+//   HE_GI_PROTO_SIGP=t     a-trous plane stop in texel footprints (default 1)
+//   HE_GI_PROTO_NPOW=e     a-trous normal power (default 32)
+//   HE_GI_PROTO_BENCH=1    GI mask passes in an own command buffer, GPU ms logged
+//   HE_GI_PROTO_EARLY=1    a-trous early out on fully lit / fully shadowed pixels
+//   HE_GI_PROTO_BILERP=1   bilinear history reprojection (4 taps, per-tap surface test)
+//                     =2   same, reprojected as a motion vector from the pixel centre
+static void* s_protoAtrousPso = nullptr;
+static void* s_protoTmp[2]    = { nullptr, nullptr };
+static int   s_protoTmpW = 0, s_protoTmpH = 0;
+struct GIProto { int spp = 1; bool strat = false; float hist = 0.9f; int atrous = 0;
+                 float sigL = 0.0f, sigP = 1.0f, nPow = 32.0f; bool bench = false; int bilerp = 0; bool early = false; };
+static const GIProto& giProto()
+{
+	static const GIProto p = [] {
+		GIProto g;
+		auto f = [](const char* k, float d) { const char* v = std::getenv(k); return v && *v ? static_cast<float>(std::atof(v)) : d; };
+		g.spp    = std::max(1, static_cast<int>(f("HE_GI_PROTO_SPP", 1.0f)));
+		g.strat  = f("HE_GI_PROTO_STRAT", 0.0f) > 0.5f;
+		g.hist   = f("HE_GI_PROTO_HIST", 0.9f);
+		g.atrous = static_cast<int>(f("HE_GI_PROTO_ATROUS", 0.0f));
+		g.sigL   = f("HE_GI_PROTO_SIGL", 0.0f);
+		g.sigP   = f("HE_GI_PROTO_SIGP", 1.0f);
+		g.nPow   = f("HE_GI_PROTO_NPOW", 32.0f);
+		g.bench  = f("HE_GI_PROTO_BENCH", 0.0f) > 0.5f;
+		g.bilerp = static_cast<int>(f("HE_GI_PROTO_BILERP", 0.0f));
+		g.early  = f("HE_GI_PROTO_EARLY", 0.0f) > 0.5f;
+		HE_LOG_INFO(RHI, "MetalRenderer: PROTO GI mask spp=%d strat=%d hist=%.3f atrous=%d sigL=%.2f sigP=%.2f nPow=%.0f bench=%d bilerp=%d",
+		            g.spp, g.strat ? 1 : 0, g.hist, g.atrous, g.sigL, g.sigP, g.nPow, g.bench ? 1 : 0, g.bilerp);
+		return g;
+	}();
+	return p;
+}
