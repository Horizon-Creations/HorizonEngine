+// PROTO(Thema 134): one edge-aware a-trous iteration (B3 5x5, holes = step).
+// x = step in texels (0 = plain copy), y = 1 → read .a (history) else .r,
+// z = sigmaL (0 = no value stop), w = effective history samples (Bernoulli
+// sigma = sqrt(c(1-c)/w)).
+struct GIAtrousParams { float4 p; float4 q; }; // q.x = plane sigma (texels), q.y = normal power
+fragment float4 giShadowAtrous(GIFsOut in [[stage_in]],
+                               texture2d<float> src  [[texture(0)]],
+                               texture2d<float> gPos [[texture(1)]],
+                               texture2d<float> gNrm [[texture(2)]],
+                               sampler          smp  [[sampler(0)]],
+                               constant GIAtrousParams& A [[buffer(0)]])
+{
+	const bool fromA = A.p.y > 0.5;
+	float4 s0 = src.sample(smp, in.uv);
+	float  c  = fromA ? s0.a : s0.r;
+	const float step = A.p.x;
+	float4 pv = gPos.sample(smp, in.uv);
+	if (step < 0.5 || pv.a < 0.5) return float4(c, 0.0, 0.0, 1.0);
+	const float2 texel = 1.0 / float2(src.get_width(), src.get_height());
+	const float3 n = gNrm.sample(smp, in.uv).xyz;
+	const float3 gx = gPos.sample(smp, in.uv + float2(texel.x, 0.0)).xyz;
+	const float3 gy = gPos.sample(smp, in.uv + float2(0.0, texel.y)).xyz;
+	const float  fp = max(max(length(gx - pv.xyz), length(gy - pv.xyz)), 1e-4); // world size of one texel
+	const float  sig = sqrt(max(c * (1.0 - c), 0.0) / max(A.p.w, 1.0));
+	// q.z = 1: early out where this pixel and its 4 step-neighbours are all fully
+	// lit or fully shadowed — most of the screen, nothing to filter there.
+	if (A.q.z > 0.5 && (c < 1e-3 || c > 1.0 - 1e-3))
+	{
+		bool flat = true;
+		for (int k = 0; k < 4 && flat; ++k)
+		{
+			const float2 o = float2(k == 0 ? 1.0 : k == 1 ? -1.0 : 0.0, k == 2 ? 1.0 : k == 3 ? -1.0 : 0.0);
+			const float4 sn = src.sample(smp, in.uv + o * 2.0 * step * texel);
+			flat = abs((fromA ? sn.a : sn.r) - c) < 1e-3;
+		}
+		if (flat) return float4(c, 0.0, 0.0, 1.0);
+	}
+	const float  h[5] = { 1.0 / 16.0, 1.0 / 4.0, 3.0 / 8.0, 1.0 / 4.0, 1.0 / 16.0 };
+	float sum = 0.0, wsum = 0.0;
+	for (int y = -2; y <= 2; ++y)
+		for (int x = -2; x <= 2; ++x)
+		{
+			const float2 uv = in.uv + float2(float(x), float(y)) * step * texel;
+			float4 q = gPos.sample(smp, uv);
+			if (q.a < 0.5) continue;
+			float4 sq = src.sample(smp, uv);
+			float  v  = fromA ? sq.a : sq.r;
+			float  w  = h[x + 2] * h[y + 2];
+			w *= exp(-abs(dot(n, q.xyz - pv.xyz)) / (A.q.x * fp));
+			w *= pow(max(dot(n, gNrm.sample(smp, uv).xyz), 0.0), A.q.y);
+			if (A.p.z > 0.0) w *= exp(-abs(v - c) / (A.p.z * sig + 1e-3));
+			sum += v * w; wsum += w;
+		}
+	return float4(wsum > 0.0 ? sum / wsum : c, 0.0, 0.0, 1.0);
+}
