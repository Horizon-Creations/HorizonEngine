# HorizonEngineConfig.cmake — GENERATED by the engine build (cmake/HorizonSDK.cmake
# from cmake/sdk/HorizonEngineConfig.cmake.in). Do not edit; rebuild HorizonSDK.
#
#   find_package(HorizonEngine @PROJECT_VERSION@ EXACT REQUIRED [COMPONENTS dev|release])
#   target_link_libraries(<t> PRIVATE HorizonEngine::Scene HorizonEngine::Rendering)
#   horizon_add_game(<name> [BUILD_CONFIG <HEGameBuildConfig.h>])   (HorizonEngineGame.cmake)
#
# Imported targets: HorizonEngine::Core, ::Net, ::Scene, ::Rendering, SDL3::SDL3.
# Their interface definitions are those of the engine libraries in this package:
# the DLL import macros and the build profile (HE_BUILD_PROFILE_DEV/RELEASE), so
# everything compiled against it sees the same Platform/BuildProfile.h switches
# the libraries were compiled with. A profile is a property of the package: ask
# for one with COMPONENTS, and a package of the other profile reports not found.
# Every path is relative to this file; the SDK can be moved as a whole.

cmake_policy(PUSH)
cmake_policy(VERSION 3.20)

get_filename_component(_HE_PREFIX "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)

set(HorizonEngine_BUILD_PROFILE   "@HE_BUILD_PROFILE@")
set(HorizonEngine_RUNTIME_FLAVOR  "@HE_RUNTIME_FLAVOR@")
set(HorizonEngine_VULKAN_ENABLED  @HE_SDK_VULKAN_ENABLED@)
set(HorizonEngine_HAS_SHADERS     @HE_SDK_SHADERS@)
set(HorizonEngine_PROFILING       @HE_PROFILING@)
set(HorizonEngine_INCLUDE_DIR     "${_HE_PREFIX}/include")
set(HorizonEngine_LIBRARY_DIR     "${_HE_PREFIX}/lib")
set(HorizonEngine_RUNTIME_DIR     "${_HE_PREFIX}/@HE_SDK_RUNTIME_SUBDIR@")
set(HorizonEngine_GAME_SOURCE_DIR "${_HE_PREFIX}/share/HorizonEngine/game")
set(HorizonEngine_TEMPLATE_DIR    "${_HE_PREFIX}/share/HorizonEngine/template")
set(HorizonEngine_SHADER_DIR      "${_HE_PREFIX}/share/HorizonEngine/Shaders")

# ── Profile components ───────────────────────────────────────────────────────
foreach(_he_comp IN LISTS HorizonEngine_FIND_COMPONENTS)
    if(_he_comp STREQUAL "dev" OR _he_comp STREQUAL "release")
        if(NOT _he_comp STREQUAL HorizonEngine_BUILD_PROFILE)
            set(HorizonEngine_FOUND FALSE)
            set(HorizonEngine_NOT_FOUND_MESSAGE "this SDK (${_HE_PREFIX}) was built with the '${HorizonEngine_BUILD_PROFILE}' profile, '${_he_comp}' was asked for")
            cmake_policy(POP)
            return()
        endif()
        set(HorizonEngine_${_he_comp}_FOUND TRUE)
    elseif(HorizonEngine_FIND_REQUIRED_${_he_comp})
        set(HorizonEngine_FOUND FALSE)
        set(HorizonEngine_NOT_FOUND_MESSAGE "unknown component '${_he_comp}' (the components are the profiles: dev, release)")
        cmake_policy(POP)
        return()
    endif()
endforeach()

# ── Imported targets ─────────────────────────────────────────────────────────
function(_horizon_engine_import target location implib definitions dependencies)
    add_library(${target} SHARED IMPORTED)
    set_target_properties(${target} PROPERTIES
        IMPORTED_LOCATION "${location}"
        INTERFACE_INCLUDE_DIRECTORIES "${_HE_PREFIX}/include"
        INTERFACE_COMPILE_DEFINITIONS "${definitions}"
        INTERFACE_LINK_LIBRARIES "${dependencies}")
    if(implib)
        set_target_properties(${target} PROPERTIES IMPORTED_IMPLIB "${implib}")
    endif()
endfunction()

if(NOT TARGET HorizonEngine::Core)
    set(_he_rt "${HorizonEngine_RUNTIME_DIR}")
    set(_he_lib "${HorizonEngine_LIBRARY_DIR}")
    if(@HE_SDK_IMPLIB@)
        set(_he_win TRUE)
    else()
        set(_he_win FALSE)
    endif()
    macro(_he_implib var name)
        if(_he_win)
            set(${var} "${_he_lib}/${name}")
        else()
            set(${var} "")
        endif()
    endmacro()

    if(NOT TARGET SDL3::SDL3)
        _he_implib(_he_imp "$<TARGET_LINKER_FILE_NAME:@HE_SDK_SDL_TARGET@>")
        _horizon_engine_import(SDL3::SDL3
            "${_he_rt}/$<TARGET_FILE_NAME:@HE_SDK_SDL_TARGET@>" "${_he_imp}" "" "")
    endif()

    # NOMINMAX / WIN32_LEAN_AND_MEAN / HE_PROFILING_ENABLED: directory-level
    # definitions of the engine build, on every engine target there. On Core,
    # which every other target links.
    set(_he_core_defs "@HE_SDK_DEFS_HorizonCore@")
    list(APPEND _he_core_defs @HE_SDK_GLOBAL_DEFINITIONS@)

    _he_implib(_he_imp "$<TARGET_LINKER_FILE_NAME:HorizonCore>")
    _horizon_engine_import(HorizonEngine::Core
        "${_he_rt}/$<TARGET_FILE_NAME:HorizonCore>" "${_he_imp}"
        "${_he_core_defs}" "SDL3::SDL3")
    set_property(TARGET HorizonEngine::Core PROPERTY INTERFACE_COMPILE_FEATURES cxx_std_20)

    _he_implib(_he_imp "$<TARGET_LINKER_FILE_NAME:HorizonNet>")
    _horizon_engine_import(HorizonEngine::Net
        "${_he_rt}/$<TARGET_FILE_NAME:HorizonNet>" "${_he_imp}"
        "@HE_SDK_DEFS_HorizonNet@" "HorizonEngine::Core")

    _he_implib(_he_imp "$<TARGET_LINKER_FILE_NAME:HorizonScene>")
    _horizon_engine_import(HorizonEngine::Scene
        "${_he_rt}/$<TARGET_FILE_NAME:HorizonScene>" "${_he_imp}"
        "@HE_SDK_DEFS_HorizonScene@" "HorizonEngine::Core;HorizonEngine::Net")

    _he_implib(_he_imp "$<TARGET_LINKER_FILE_NAME:HorizonRendering>")
    _horizon_engine_import(HorizonEngine::Rendering
        "${_he_rt}/$<TARGET_FILE_NAME:HorizonRendering>" "${_he_imp}"
        "@HE_SDK_DEFS_HorizonRendering@" "HorizonEngine::Core")

    unset(_he_rt)
    unset(_he_lib)
    unset(_he_win)
    unset(_he_imp)
    unset(_he_core_defs)
endif()

# The runtime files a game needs beside its executable (Windows DLLs; elsewhere
# the shared libs, which the executable finds through its rpath otherwise).
set(HorizonEngine_RUNTIME_TARGETS
    HorizonEngine::Core HorizonEngine::Net HorizonEngine::Scene
    HorizonEngine::Rendering SDL3::SDL3)

include("${CMAKE_CURRENT_LIST_DIR}/HorizonEngineGame.cmake")

set(HorizonEngine_FOUND TRUE)
cmake_policy(POP)
