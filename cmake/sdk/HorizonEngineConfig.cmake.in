# HorizonEngineConfig.cmake — GENERATED by the engine build (cmake/HorizonSDK.cmake
# from cmake/sdk/HorizonEngineConfig.cmake.in). Do not edit; rebuild HorizonSDK.
#
#   find_package(HorizonEngine @PROJECT_VERSION@ EXACT REQUIRED [COMPONENTS dev|release])
#   target_link_libraries(<t> PRIVATE HorizonEngine::HorizonEngine)   (::Core, ::Scene, ... forward to it)
#   horizon_add_game(<name> [BUILD_CONFIG <HEGameBuildConfig.h>])   (HorizonEngineGame.cmake)
#
# One SDK, one shared include/, a lib set per build profile (lib/dev, lib/release),
# each described by its HorizonEngineTargets-<profile>.cmake. The profile is the
# consumer's choice, first match wins:
#   1. COMPONENTS dev | release;
#   2. the consumer's HE_BUILD_PROFILE variable (-DHE_BUILD_PROFILE=release);
#   3. the only lib set this SDK holds.
# A profile whose lib set is not installed, or was installed with other headers
# than include/ now holds, is "not found" with the reason. HorizonEngine_PROFILES
# lists the installed ones, HorizonEngine_BUILD_PROFILE is the chosen one.
# Every path is relative to this file; the SDK can be moved as a whole.

cmake_policy(PUSH)
cmake_policy(VERSION 3.20)

get_filename_component(_HE_PREFIX "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)

set(HorizonEngine_INCLUDE_DIR     "${_HE_PREFIX}/include")
set(HorizonEngine_GAME_SOURCE_DIR "${_HE_PREFIX}/share/HorizonEngine/game")
set(HorizonEngine_TEMPLATE_DIR    "${_HE_PREFIX}/share/HorizonEngine/template")

set(HorizonEngine_PROFILES "")
foreach(_he_p dev release)
    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/HorizonEngineTargets-${_he_p}.cmake")
        list(APPEND HorizonEngine_PROFILES ${_he_p})
    endif()
endforeach()
# For the messages: a list passed through a macro argument loses its ';'.
list(JOIN HorizonEngine_PROFILES ", " _he_installed)
if(_he_installed STREQUAL "")
    set(_he_installed "none")
endif()

macro(_he_not_found)
    set(HorizonEngine_FOUND FALSE)
    string(CONCAT HorizonEngine_NOT_FOUND_MESSAGE ${ARGN})
    cmake_policy(POP)
    return()
endmacro()

# ── Which profile ────────────────────────────────────────────────────────────
set(_he_want "")
foreach(_he_comp IN LISTS HorizonEngine_FIND_COMPONENTS)
    if(_he_comp STREQUAL "dev" OR _he_comp STREQUAL "release")
        if(_he_want AND NOT _he_want STREQUAL _he_comp)
            _he_not_found("one profile per project: both 'dev' and 'release' were asked for")
        endif()
        set(_he_want ${_he_comp})
    elseif(HorizonEngine_FIND_REQUIRED_${_he_comp})
        _he_not_found("unknown component '${_he_comp}' (the components are the profiles: dev, release)")
    endif()
endforeach()
if(NOT _he_want AND NOT "${HE_BUILD_PROFILE}" STREQUAL "")
    set(_he_want "${HE_BUILD_PROFILE}")
endif()
if(NOT _he_want)
    list(LENGTH HorizonEngine_PROFILES _he_n)
    if(_he_n EQUAL 0)
        _he_not_found("this SDK (${_HE_PREFIX}) holds no engine lib set")
    elseif(NOT _he_n EQUAL 1)
        _he_not_found("this SDK (${_HE_PREFIX}) holds the lib sets ${_he_installed}. "
                      "Choose one: COMPONENTS dev|release or -DHE_BUILD_PROFILE=dev|release")
    endif()
    set(_he_want ${HorizonEngine_PROFILES})
endif()
if(NOT _he_want IN_LIST HorizonEngine_PROFILES)
    _he_not_found("this SDK (${_HE_PREFIX}) has no '${_he_want}' lib set (installed: "
                  "${_he_installed}). Build the HorizonSDK target of a "
                  "HE_BUILD_PROFILE=${_he_want} engine tree into it")
endif()

# ── Same headers as the lib set ──────────────────────────────────────────────
set(_he_stamp_now "")
set(_he_stamp_set "")
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/HorizonEngineHeaders.txt")
    file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/HorizonEngineHeaders.txt" _he_stamp_now LIMIT_COUNT 1)
endif()
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/HorizonEngineHeaders-${_he_want}.txt")
    file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/HorizonEngineHeaders-${_he_want}.txt" _he_stamp_set LIMIT_COUNT 1)
endif()
if(_he_stamp_now STREQUAL "" OR NOT _he_stamp_now STREQUAL _he_stamp_set)
    _he_not_found("this SDK's '${_he_want}' lib set (${_HE_PREFIX}) was installed with other "
                  "headers than include/ holds now (another engine build installed over it). "
                  "Install both lib sets from the same engine sources.")
endif()

set(HorizonEngine_BUILD_PROFILE "${_he_want}")
set(HorizonEngine_${_he_want}_FOUND TRUE)

# ── Imported targets ─────────────────────────────────────────────────────────
function(_horizon_engine_import target location implib definitions dependencies)
    add_library(${target} SHARED IMPORTED)
    set_target_properties(${target} PROPERTIES
        IMPORTED_LOCATION "${location}"
        INTERFACE_INCLUDE_DIRECTORIES "${_HE_PREFIX}/include"
        INTERFACE_COMPILE_DEFINITIONS "${definitions}"
        INTERFACE_LINK_LIBRARIES "${dependencies}")
    if(implib)
        set_target_properties(${target} PROPERTIES IMPORTED_IMPLIB "${implib}")
    endif()
endfunction()

include("${CMAKE_CURRENT_LIST_DIR}/HorizonEngineTargets-${_he_want}.cmake")

# The runtime files a game needs beside its executable (Windows DLLs; elsewhere
# the shared libs, which the executable finds through its rpath otherwise).
set(HorizonEngine_RUNTIME_TARGETS HorizonEngine::HorizonEngine SDL3::SDL3)

include("${CMAKE_CURRENT_LIST_DIR}/HorizonEngineGame.cmake")

unset(_he_want)
unset(_he_installed)
unset(_he_n)
unset(_he_stamp_now)
unset(_he_stamp_set)
set(HorizonEngine_FOUND TRUE)
cmake_policy(POP)
