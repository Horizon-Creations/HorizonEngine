# HorizonEngineTargets-@HE_BUILD_PROFILE@.cmake — GENERATED by the engine build
# (cmake/HorizonSDK.cmake from cmake/sdk/HorizonEngineTargets.cmake.in). Do not
# edit; rebuild HorizonSDK in a HE_BUILD_PROFILE=@HE_BUILD_PROFILE@ engine tree.
#
# The '@HE_BUILD_PROFILE@' lib set of the engine SDK: the imported target
# HorizonEngine::HorizonEngine (the engine as one library, Thema 211 step 10) and
# SDL3::SDL3 on lib/@HE_BUILD_PROFILE@ (Windows: DLLs in bin/@HE_BUILD_PROFILE@).
# HorizonEngine::Core, ::Net, ::Scene and ::Rendering, the names of the four
# libraries it is made of, stay as forwards to it, so a project written against
# them links the one library. Its interface definitions are those of the four:
# the DLL import macros and the build profile (HE_BUILD_PROFILE_DEV/RELEASE), so
# everything compiled against it sees the Platform/BuildProfile.h switches the
# library was compiled with.
# Included by HorizonEngineConfig.cmake once the consumer's profile is chosen;
# _HE_PREFIX and _horizon_engine_import come from there.

set(HorizonEngine_RUNTIME_FLAVOR  "@HE_RUNTIME_FLAVOR@")
set(HorizonEngine_VULKAN_ENABLED  @HE_SDK_VULKAN_ENABLED@)
set(HorizonEngine_PROFILING       @HE_PROFILING@)
set(HorizonEngine_LIBRARY_DIR     "${_HE_PREFIX}/lib/@HE_BUILD_PROFILE@")
set(HorizonEngine_RUNTIME_DIR     "${_HE_PREFIX}/@HE_SDK_RUNTIME_SUBDIR@/@HE_BUILD_PROFILE@")

if(NOT TARGET HorizonEngine::Core)
    set(_he_rt "${HorizonEngine_RUNTIME_DIR}")
    set(_he_lib "${HorizonEngine_LIBRARY_DIR}")
    if(@HE_SDK_IMPLIB@)
        set(_he_win TRUE)
    else()
        set(_he_win FALSE)
    endif()
    macro(_he_implib var name)
        if(_he_win)
            set(${var} "${_he_lib}/${name}")
        else()
            set(${var} "")
        endif()
    endmacro()

    if(NOT TARGET SDL3::SDL3)
        _he_implib(_he_imp "$<TARGET_LINKER_FILE_NAME:@HE_SDK_SDL_TARGET@>")
        _horizon_engine_import(SDL3::SDL3
            "${_he_rt}/$<TARGET_FILE_NAME:@HE_SDK_SDL_TARGET@>" "${_he_imp}" "" "")
    endif()

    # NOMINMAX / WIN32_LEAN_AND_MEAN / HE_PROFILING_ENABLED: directory-level
    # definitions of the engine build, on every engine target there.
    set(_he_core_defs "@HE_SDK_DEFS_HorizonEngine@")
    list(APPEND _he_core_defs @HE_SDK_GLOBAL_DEFINITIONS@)

    _he_implib(_he_imp "$<TARGET_LINKER_FILE_NAME:HorizonEngine>")
    _horizon_engine_import(HorizonEngine::HorizonEngine
        "${_he_rt}/$<TARGET_FILE_NAME:HorizonEngine>" "${_he_imp}"
        "${_he_core_defs}" "SDL3::SDL3")
    set_property(TARGET HorizonEngine::HorizonEngine PROPERTY INTERFACE_COMPILE_FEATURES cxx_std_20)

    foreach(_he_part Core Net Scene Rendering)
        add_library(HorizonEngine::${_he_part} INTERFACE IMPORTED)
        set_property(TARGET HorizonEngine::${_he_part}
            PROPERTY INTERFACE_LINK_LIBRARIES HorizonEngine::HorizonEngine)
    endforeach()
    unset(_he_part)

    unset(_he_rt)
    unset(_he_lib)
    unset(_he_win)
    unset(_he_imp)
    unset(_he_core_defs)
endif()
