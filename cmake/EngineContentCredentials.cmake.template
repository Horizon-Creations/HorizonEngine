# ─── EngineContent SFTP endpoint, local build only ────────────────────────────
# Copy this file to cmake/EngineContentCredentials.cmake (WITHOUT .template) and
# fill in the values. That name is gitignored: this repository is public, so the
# endpoint never goes into a tracked file. CI builds get the same values from
# repository secrets — see .github/workflows/ci.yml.
#
# src/HE_ContentSync/CMakeLists.txt includes the copy when it exists. A -D on
# the configure line still wins over it, and having no file at all is a normal
# state: the Editor then reports the remote library as "not configured" and
# behaves exactly as it did before the feature existed.
#
# Rotation: change the password here AND in the ENGINE_CONTENT_PASSWORD secret.
set(HE_ENGINE_CONTENT_HOST     "" CACHE STRING "")   # e.g. "access-xxxxxxx.webspace-host.com"
set(HE_ENGINE_CONTENT_PORT     "22" CACHE STRING "")
set(HE_ENGINE_CONTENT_USER     "" CACHE STRING "")
set(HE_ENGINE_CONTENT_PASSWORD "" CACHE STRING "")
set(HE_ENGINE_CONTENT_BASEPATH "" CACHE STRING "")   # "" = the account's own root
