+					{
+						++viol; ++violWin;
+						if (hsh != hashes[(k - g_t97N) % 16]) { ++hazards; ++hazardsWin; g_t97Victim[(k - g_t97N) % 64] = k - g_t97N + 1; }
+					}
+					g_t97Queue->Signal(g_t97Fence, k);
+					++k;
+					if (k % 300 == 0)
+					{
+						HE_LOG_INFO(Editor, "T97 nfif=%d frames=%llu inflightOverwrites=%llu (last300=%llu) hazardous=%llu (last300=%llu) contentChangedFrames(last300)=%llu vtxCountChanged(last300)=%llu vtx=%d..%d",
+							g_t97N, (unsigned long long)k, (unsigned long long)viol, (unsigned long long)violWin,
+							(unsigned long long)hazards, (unsigned long long)hazardsWin, (unsigned long long)hashChanges,
+							(unsigned long long)vtxChanges, minVtx, maxVtx);
+						violWin = 0; hazardsWin = 0; hashChanges = 0; vtxChanges = 0; minVtx = 1 << 30; maxVtx = 0;
+					}
+				}
+				static const bool t97CapOn = std::getenv("HE_T97_CAPDIR") != nullptr; // T97-INSTR
+				if (t97CapOn && t97k != UINT64_MAX)
+				{
+					auto* dx12r = static_cast<D3D12Renderer*>(renderer());
+					auto* bb    = static_cast<ID3D12Resource*>(dx12r->T97GetBackBuffer());
+					if (!g_t97Cap.tried && bb) g_t97Cap.init(static_cast<ID3D12Device*>(dx12r->GetDevice()), bb);
+					g_t97Cap.process(g_t97Fence->GetCompletedValue());
+					g_t97Cap.frame(cmdList, bb, drawData, t97k, srvHeap);
