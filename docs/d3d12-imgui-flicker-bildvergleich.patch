+				uint64_t t97k = UINT64_MAX; // T97-INSTR
+				if (g_t97Fence && drawData->DisplaySize.x > 0.0f && drawData->DisplaySize.y > 0.0f)
+				{
+					static uint64_t k = 0, viol = 0, violWin = 0, vtxChanges = 0;
+					t97k = k;
+					static int lastVtx = -1, minVtx = 1 << 30, maxVtx = 0;
+					if (drawData->TotalVtxCount != lastVtx) ++vtxChanges;
+					lastVtx = drawData->TotalVtxCount;
+					minVtx = (std::min)(minVtx, lastVtx); maxVtx = (std::max)(maxVtx, lastVtx);
+					// FNV-1a over this frame's VB+IB bytes: an in-flight overwrite only
+					// shows if the bytes differ from those of frame k-N (same slot).
+					static uint64_t hashes[16] = {}, hashChanges = 0, hazards = 0, hazardsWin = 0;
+					uint64_t hsh = 1469598103934665603ull;
+					auto mix = [&](const void* p, size_t n) { auto* b = static_cast<const unsigned char*>(p); for (size_t i = 0; i < n; ++i) { hsh ^= b[i]; hsh *= 1099511628211ull; } };
+					for (const ImDrawList* dl : drawData->CmdLists)
+					{
+						mix(dl->VtxBuffer.Data, dl->VtxBuffer.Size * sizeof(ImDrawVert));
+						mix(dl->IdxBuffer.Data, dl->IdxBuffer.Size * sizeof(ImDrawIdx));
+					}
+					if (k > 0 && hsh != hashes[(k - 1) % 16]) ++hashChanges;
+					hashes[k % 16] = hsh;
