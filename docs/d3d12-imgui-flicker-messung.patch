@@ -1070,6 +1081,46 @@ void EditorApplication::OnInit()
 				scissor.bottom = static_cast<LONG>(drawData->DisplaySize.y);
 				cmdList->RSSetScissorRects(1, &scissor);
 
+				// T97-INSTR: ImGui (main viewport) writes VB/IB slot k % N, last used by
+				// frame k-N. Signal(k) is queued before frame k's ExecuteCommandLists, so
+				// completed >= k means frames 0..k-1 are done. Overwrite in flight iff
+				// frame k-N is not done yet: completed < k-N+1.
+				if (g_t97Fence && drawData->DisplaySize.x > 0.0f && drawData->DisplaySize.y > 0.0f)
+				{
+					static uint64_t k = 0, viol = 0, violWin = 0, vtxChanges = 0;
+					static int lastVtx = -1, minVtx = 1 << 30, maxVtx = 0;
+					if (drawData->TotalVtxCount != lastVtx) ++vtxChanges;
+					lastVtx = drawData->TotalVtxCount;
+					minVtx = (std::min)(minVtx, lastVtx); maxVtx = (std::max)(maxVtx, lastVtx);
+					// FNV-1a over this frame's VB+IB bytes: an in-flight overwrite only
+					// shows if the bytes differ from those of frame k-N (same slot).
+					static uint64_t hashes[16] = {}, hashChanges = 0, hazards = 0, hazardsWin = 0;
+					uint64_t hsh = 1469598103934665603ull;
+					auto mix = [&](const void* p, size_t n) { auto* b = static_cast<const unsigned char*>(p); for (size_t i = 0; i < n; ++i) { hsh ^= b[i]; hsh *= 1099511628211ull; } };
+					for (const ImDrawList* dl : drawData->CmdLists)
+					{
+						mix(dl->VtxBuffer.Data, dl->VtxBuffer.Size * sizeof(ImDrawVert));
+						mix(dl->IdxBuffer.Data, dl->IdxBuffer.Size * sizeof(ImDrawIdx));
+					}
+					if (k > 0 && hsh != hashes[(k - 1) % 16]) ++hashChanges;
+					hashes[k % 16] = hsh;
+					const uint64_t done = g_t97Fence->GetCompletedValue();
+					if (k >= static_cast<uint64_t>(g_t97N) && done < k - g_t97N + 1)
+					{
+						++viol; ++violWin;
+						if (hsh != hashes[(k - g_t97N) % 16]) { ++hazards; ++hazardsWin; }
+					}
+					g_t97Queue->Signal(g_t97Fence, k);
+					++k;
+					if (k % 300 == 0)
+					{
+						HE_LOG_INFO(Editor, "T97 nfif=%d frames=%llu inflightOverwrites=%llu (last300=%llu) hazardous=%llu (last300=%llu) contentChangedFrames(last300)=%llu vtxCountChanged(last300)=%llu vtx=%d..%d",
+							g_t97N, (unsigned long long)k, (unsigned long long)viol, (unsigned long long)violWin,
+							(unsigned long long)hazards, (unsigned long long)hazardsWin, (unsigned long long)hashChanges,
+							(unsigned long long)vtxChanges, minVtx, maxVtx);
+						violWin = 0; hazardsWin = 0; hashChanges = 0; vtxChanges = 0; minVtx = 1 << 30; maxVtx = 0;
+					}
+				}
 				ImGui_ImplDX12_RenderDrawData(drawData, cmdList);
 				break;
 			}
